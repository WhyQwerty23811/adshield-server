[Unit]
Description=AdShield Private DNS & Ad-Blocking Server (DoT/DoH/UDP)
After=network.target network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adshield
ExecStart=/usr/bin/python3 /opt/adshield/adshield_server.py
Restart=always
RestartSec=3
LimitNOFILE=65535

# Linux Capabilities to bind to low ports (53, 443, 853)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

